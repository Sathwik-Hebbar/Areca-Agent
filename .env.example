# Environment Configuration for ArecaAgent

# Server Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-super-secret-jwt-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (Single Postgres, 5 logical schemas)
POSTGRES_USER=areca_user
POSTGRES_PASSWORD=areca_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=areca_agent_db
DATABASE_URL=postgresql://areca_user:areca_pass@localhost:5432/areca_agent_db

# Gemini API Integration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DAILY_BUDGET_CAP=100

# Weather API Integration
WEATHER_API_KEY=your-openweather-or-tomorrow-api-key

# Data.gov.in Mandi Market Price API
DATA_GOV_IN_API_KEY=your-datagov-api-key

# MQTT Broker (for ESP32 IoT sensors)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
